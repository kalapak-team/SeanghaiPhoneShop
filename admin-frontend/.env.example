# Admin — copy to .env.local (local) or set in Vercel → Settings → Environment Variables
#
# Option A (recommended on Vercel): call Railway directly from the browser
NEXT_PUBLIC_API_URL=https://YOUR-RAILWAY-SERVICE.up.railway.app/api
#
# Option B: keep NEXT_PUBLIC_API_URL=/api and proxy via Next rewrite
# NEXT_PUBLIC_API_URL=/api
# BACKEND_URL=https://YOUR-RAILWAY-SERVICE.up.railway.app
